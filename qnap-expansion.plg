<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name    "qnap-expansion">
  <!ENTITY author  "QNAP Expansion project">
  <!ENTITY version "2026.11.09a">
  <!ENTITY gitURL  "https://raw.githubusercontent.com/luuvasara/unraid-qnap-expansion/main">
  <!ENTITY pluginURL "&gitURL;/qnap-expansion.plg">
  <!ENTITY pkg     "qnap-expansion-&version;-x86_64-1.txz">
  <!ENTITY pkgURL  "&gitURL;/packages/&pkg;">
  <!ENTITY md5     "47333634a070f60609f1b136d8817cf2">
]>
<!-- QNAP Expansion: support for the QNAP TL-D1600S JBOD enclosure on its QXP card, from the enclosure profile of the plugin kit.
     No daemon, no driver, no background job: the pages read Unraid's own state and sysfs when they are opened.
     Bump &version; on EVERY change; &md5; is filled in by build.sh from the built txz, never by hand. -->
<PLUGIN name="&name;" author="&author;" version="&version;" min="6.12.0" launch="Utilities/QnapExpansion" icon="qnap-expansion.png" pluginURL="&pluginURL;">

<CHANGES>
###2026.11.09a
- Enclosures: the unit is drawn as it looks. Front: the trays stand upright where they sit (HDD9-HDD12 top left, the four SSD trays under the LCD, HDD1-HDD8 along the bottom), with the LCD, its buttons, the status LEDs and the drive LED strip. Rear: the three fans, the switches and the four SFF-8088 ports, each with the bays it feeds and the drives the server sees through it. Each tray shows its bay, temperature, drive, Unraid slot and state; a drive being located is outlined. LEDs, fans and switches are drawn but not read.
- Main page bay labels now also show for unassigned drives (Unassigned Devices puts a "Clear Disk" link after the drive name, which hid the label).

###2026.11.08b
- Enclosures tab: the cabling form no longer upsets the numbering of the tabs that follow it.

###2026.11.08a
- First version. Utilities, QNAP Expansion, for a QNAP TL-D1600S on its QXP-1600eS-A1164 card.
- Status tab: whether the card is found (by its PCI ids and QNAP subsystem), runs on the standard ahci driver, its PCIe links run at the speed and width both ends can do, its PCIe error counters, the SATA link of each drive, and whether the cabling is confirmed. What the server cannot reach of the enclosure (fans, LEDs, firmware) is said plainly.
- Enclosures tab: a front view as the bays are labelled (HDD1-HDD12, SSD1-SSD4) with the drive in each bay and its Unraid slot, temperature and state as Unraid last read them (no drive is woken); the bay table with SMART health and Locate; the PCIe links.
- Locate reads one drive for 20 seconds so its activity light flashes. It only reads, and asks first when the drive is in standby.
- Cabling: which controller feeds which group of bays depends on how the four cables are plugged. The bays follow a measured unit until you confirm yours with Locate; the confirmation is kept on the flash drive.
</CHANGES>

<!-- pre-install: dirs, the install mode for the notes, version-preserving cleanup of old packages on flash -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name; /var/run/&name;
OLD=
for f in /var/log/packages/&name;-*-x86_64-1; do
  if [ -e "$f" ]; then OLD=${f##*/&name;-}; OLD=${OLD%-x86_64-1}; fi
done
if [ -n "$OLD" ]; then echo "update $OLD"
elif [ -e /boot/config/plugins/&name;.plg ]; then echo boot
else echo fresh
fi &gt;/var/run/&name;/install-from
for f in /boot/config/plugins/&name;/&name;-*-x86_64-1.txz; do
  case $f in */&name;-&version;-x86_64-1.txz) ;; *) if [ -f "$f" ]; then rm -f "$f"; fi ;; esac
done
</INLINE>
</FILE>

<!-- payload: downloaded to the flash (MD5 checked after the download, and for the flash copy at every boot), then upgradepkg -->
<FILE Name="/boot/config/plugins/&name;/&pkg;" Run="upgradepkg --install-new --reinstall">
<URL>&pkgURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- post-install: the notes only; nothing to start. Never fails (a failing Run at boot moves the .plg to plugins-error) -->
<FILE Run="/bin/bash">
<INLINE>
MODE=; OLD=
read -r MODE OLD 2&gt;/dev/null &lt;/var/run/&name;/install-from
FIRST_RUN="Utilities, QNAP Expansion: Status checks the card, Enclosures shows each drive in its bay. Install QNAP Hardware too for the live overview and history." \
  /usr/local/emhttp/plugins/&name;/kit/install-notes.sh "&version;" "$MODE" "$OLD" || true
rm -f /var/run/&name;/install-from
exit 0
</INLINE>
</FILE>

<!-- remove: the package and the runtime dir; the settings (cfg, confirmed cabling) stay on the flash for a reinstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &name;-&version;-x86_64-1
rm -rf /var/run/&name;
rm -f /boot/config/plugins/&name;/&pkg;
echo "qnap-expansion removed. Settings are kept in /boot/config/plugins/&name;/ (delete that folder to forget them)."
exit 0
</INLINE>
</FILE>

</PLUGIN>
